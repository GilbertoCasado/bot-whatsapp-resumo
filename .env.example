# ---------- IA ----------
# Preencha UMA das chaves: o bot usa a que estiver preenchida.
# Com as duas preenchidas, usa o Claude (ou force com PROVEDOR_IA=claude ou PROVEDOR_IA=gemini).
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# PROVEDOR_IA=claude

# ---------- Grupo ----------
# Grupos a resumir, separados por ponto e vírgula. Cada grupo gera uma mensagem
# com o título "Resumo do grupo <nome>".
# Use o nome como aparece no WhatsApp (maiúsculas, minúsculas e acentos não importam)
# ou o ID do grupo (termina em @g.us), útil se dois grupos tiverem o mesmo nome.
# Na primeira vez que encontra um grupo pelo nome, o bot guarda o ID dele em dados/grupos.json.
# Depois disso, se o grupo for renomeado no WhatsApp, o resumo continua chegando sem mexer aqui.
# "npm run parear" lista os nomes e IDs.
# Exemplo: GRUPOS=Casados;Escola do João;1203630XXXXXXXXX@g.us
GRUPOS=

# ---------- Destinatários ----------
# Números que recebem o resumo, separados por vírgula: país + DDD + número, só dígitos.
# Exemplo: DESTINATARIOS=55819XXXXXXXX,55819YYYYYYYY
DESTINATARIOS=

# Número que recebe os alertas de falha (se vazio, usa o primeiro destinatário)
NUMERO_ALERTA=

FUSO_HORARIO=America/Recife
